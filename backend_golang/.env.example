PORT=5000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET_KEY=change-this-to-a-long-random-secret

# Supabase Postgres direct connection string.
# Prefer the Supabase pooled connection string for Cloud Run.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require

# Supabase Storage upload configuration.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
SUPABASE_STORAGE_BUCKET=instaweb-uploads
# Optional. Leave empty to use SUPABASE_URL/storage/v1/object/public/<bucket>/<path>.
SUPABASE_STORAGE_PUBLIC_BASE_URL=

# Startup behavior.
AUTO_MIGRATE=true
SEED_DEMO_DATA=true
MAX_UPLOAD_BYTES=10485760

# Midtrans sandbox defaults can be overridden in Cloud Run secrets.
MIDTRANS_SERVER_KEY=replace-with-midtrans-server-key
MIDTRANS_SNAP_URL=https://app.sandbox.midtrans.com/snap/v1/transactions
MIDTRANS_API_URL=https://api.sandbox.midtrans.com/v2
